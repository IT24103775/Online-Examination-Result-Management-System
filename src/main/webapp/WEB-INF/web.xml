<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <display-name>Online Exam System</display-name>
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- User Management Servlet -->
    <servlet>
        <servlet-name>UserManagementServlet</servlet-name>
        <servlet-class>com.exam.controller.UserManagementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserManagementServlet</servlet-name>
        <url-pattern>/userManagement</url-pattern>
    </servlet-mapping>

    <!-- Define listeners in the desired execution order -->
    <listener>
        <listener-class>com.exam.util.StartupListener</listener-class>
    </listener>
    <listener>
        <listener-class>com.exam.util.AppContextListener</listener-class>
    </listener>
</web-app>
